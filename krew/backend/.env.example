# ─── Krew Backend Environment ───

# Database
DATABASE_URL=postgresql+asyncpg://krew:krew_secret@localhost:5432/krew
DATABASE_URL_SYNC=postgresql://krew:krew_secret@localhost:5432/krew

# Redis
REDIS_URL=redis://localhost:6379/0

# AI / LLM
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096

# RAG
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=sk-...  # for embeddings only

# Channels
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=krew-webhook-verify

SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# Auth
JWT_SECRET=change-this-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# App
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://krew.sa
